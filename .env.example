# Single root .env, loaded by both apps/api (via dotenv) and apps/web (via
# @next/env in next.config.ts). `pnpm setup` copies this file to `.env` on
# first run and never overwrites values you've already set.
#
# This file only documents what Phase 0 needs to boot. Phase 2 adds the full
# AI_* provider contract (docs/PROVIDERS.md) and Phase 3 adds the rest of the
# API's config surface — both will extend this file, not replace it.

# --- apps/api -----------------------------------------------------------
PORT=3001

# --- apps/web -------------------------------------------------------------
# Base URL the browser uses to reach apps/api.
NEXT_PUBLIC_API_URL=http://localhost:3001

# --- Supabase ---------------------------------------------------------------
# For local dev, `pnpm setup` runs `supabase start` and writes these for you
# from `supabase status -o env` — you shouldn't need to set them by hand.
# For a hosted Supabase project instead, see the "Hosted Supabase" section of
# the root README and set these to your project's values.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# scripts only (scripts/seed.mjs) — apps/api never reads this at runtime, by
# design: every API request runs under RLS as the authenticated user. See
# docs/DECISIONS.md.
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- AI provider (Phase 2) ---------------------------------------------
# Leave both providers unset (or "mock") to run in keyless demo mode: the
# mock chat/embedding models make the whole app usable with no API key.
# See docs/PROVIDERS.md for the full swap guide (OpenAI, Groq, Together,
# OpenRouter, Ollama, custom) once Phase 2 lands.
AI_CHAT_PROVIDER=mock
AI_EMBEDDING_PROVIDER=mock
