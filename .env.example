# Single root .env, loaded by both apps/api (via dotenv) and apps/web (via
# @next/env in next.config.ts). `pnpm setup` copies this file to `.env` on
# first run and never overwrites values you've already set.
#
# This file only documents what Phase 0 needs to boot. Phase 2 adds the full
# AI_* provider contract (docs/PROVIDERS.md) and Phase 3 adds the rest of the
# API's config surface — both will extend this file, not replace it.

# --- apps/api -----------------------------------------------------------
PORT=3001
NODE_ENV=development
# The only origin CORS allows.
WEB_ORIGIN=http://localhost:3000

# --- apps/web -------------------------------------------------------------
# Base URL the browser uses to reach apps/api.
NEXT_PUBLIC_API_URL=http://localhost:3001
# Used only to build the email-confirmation redirect link in the signup
# server action ((auth)/actions.ts); falls back to localhost:3000 if unset,
# so this only needs to be set for a non-local deployment.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase ---------------------------------------------------------------
# For local dev, `pnpm setup` runs `supabase start` and writes these for you
# from `supabase status -o env` — you shouldn't need to set them by hand.
# For a hosted Supabase project instead, see the "Hosted Supabase" section of
# the root README and set these to your project's values.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# scripts only (scripts/seed.mjs) — apps/api never reads this at runtime, by
# design: every API request runs under RLS as the authenticated user. See
# docs/DECISIONS.md.
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Local/self-hosted Supabase only — a hosted project's AuthGuard verification
# never touches this (see supabase/config.toml's closing note and
# docs/DECISIONS.md Phase 3, D3.1). `supabase start`'s fixed local value:
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long

# --- Rate limiting (Phase 3) ----------------------------------------------
# Generous default, applied to CRUD routes; a stricter "chat" bucket is
# registered too but unused until Phase 5 adds POST /chat/stream.
THROTTLE_DEFAULT_LIMIT=120
THROTTLE_DEFAULT_TTL_MS=60000
THROTTLE_CHAT_LIMIT=20
THROTTLE_CHAT_TTL_MS=60000

# --- Chunking knobs (Phase 3 owns this file; consumed starting Phase 4) ---
RAG_CHUNK_TOKENS=450
RAG_CHUNK_MAX_TOKENS=600
RAG_CHUNK_OVERLAP_TOKENS=60

# --- Retrieval/chat knobs (Phase 3 owns this file; consumed starting Phase 5) ---
RAG_TOP_K=8
RAG_MIN_SIMILARITY=0.25
RAG_CONTEXT_TOKENS=3500
RAG_HISTORY_TOKENS=1500
RAG_QUERY_REWRITE=true
RAG_QUERY_REWRITE_TIMEOUT_MS=5000

# --- AI provider (Phase 2) ---------------------------------------------
# Leave both providers unset (or "mock") to run in keyless demo mode: the
# mock chat/embedding models make the whole app usable with no API key.
# See docs/PROVIDERS.md for the full swap guide (OpenAI, Groq, Together,
# OpenRouter, Ollama, custom) and `pnpm ai:check` to verify whatever you set
# below actually works before wiring it into the rest of the app.
#
# Valid values for AI_CHAT_PROVIDER / AI_EMBEDDING_PROVIDER:
#   mock | openai | groq | together | openrouter | ollama | custom
# (groq has no embeddings API — use a different AI_EMBEDDING_PROVIDER.)
AI_CHAT_PROVIDER=mock
AI_CHAT_MODEL=mock-chat
AI_EMBEDDING_PROVIDER=mock
AI_EMBEDDING_MODEL=mock-embedding

# Only needed for provider=custom (points at any OpenAI-compatible
# /v1/chat/completions + /v1/embeddings server), or to override a preset's
# default base URL.
# AI_CHAT_BASE_URL=
# AI_EMBEDDING_BASE_URL=

# Provider-specific keys — set only the one(s) your chosen provider(s) need.
# An explicit AI_CHAT_API_KEY / AI_EMBEDDING_API_KEY always overrides these,
# and AI_API_KEY is a generic fallback tried after the provider-specific var.
# OPENAI_API_KEY=
# GROQ_API_KEY=
# TOGETHER_API_KEY=
# OPENROUTER_API_KEY=
# AI_CHAT_API_KEY=
# AI_EMBEDDING_API_KEY=
# AI_API_KEY=

# Must stay 1536 to match document_chunks.embedding's column width (see
# supabase/migrations). Changing it requires an ALTER on that column first —
# see the migration template in docs/PROVIDERS.md.
AI_EMBEDDING_DIMENSIONS=1536

# Some providers/models reject an explicit `temperature` param — set to
# false if you hit that.
AI_CHAT_SUPPORTS_TEMPERATURE=true

AI_REQUEST_TIMEOUT_MS=60000
AI_MAX_RETRIES=2
