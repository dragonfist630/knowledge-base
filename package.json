{
  "name": "knowledge-base",
  "private": true,
  "version": "0.1.0",
  "description": "AI-Powered Knowledge Base (Goodspeed Technical Assessment)",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:e2e": "pnpm --filter web exec playwright test",
    "check:dev-boot": "node scripts/check-dev-boot.mjs",
    "clean": "turbo clean",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > packages/shared/src/database.types.ts",
    "db:test": "supabase test db",
    "seed": "node scripts/seed.mjs",
    "eval": "node scripts/eval-retrieval.mjs",
    "ai:check": "pnpm --filter api exec node dist/cli/ai-check.js"
  },
  "devDependencies": {
    "@kb/ai": "workspace:*",
    "@kb/rag-core": "workspace:*",
    "picocolors": "1.1.1",
    "supabase": "2.117.0",
    "turbo": "2.10.13",
    "typescript": "5.9.3"
  }
}
